# Copy to .env.local (and add the same keys in Vercel > Project > Settings > Environment Variables)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set these to the exact venue details so the Google Maps link and map pin are accurate.
NEXT_PUBLIC_LOCATION_ADDRESS=
NEXT_PUBLIC_LOCATION_QUERY=

# Supabase > Project Settings > API
# Use the Project URL and a server-side key: the legacy service_role key (eyJ...)
# or a new secret key (sb_secret_...). Keep it SECRET, server-side only.
# Then run supabase/schema.sql in Supabase > SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# First admin owner is created on the first sign-in if admin_users is empty.
# After that, manage separate accounts at /admin/users; this password is no longer used.
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
# Generate a long random secret; the Supabase service-role key is used only as fallback.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Email (Brevo, free). Create an account at brevo.com, add and verify your sender
# under Senders & IPs > Senders, then create a key under SMTP & API > API Keys.
# Free-mail domains like proton.me cannot be authenticated, so Brevo may rewrite the
# From domain to @brevosend.com. Set EMAIL_REPLY_TO to your real address so replies
# still reach you. Leave both email keys empty to log emails in the terminal instead.
BREVO_API_KEY=
EMAIL_FROM=Lucky Paddle <you@proton.me>
EMAIL_REPLY_TO=you@proton.me

# Optional: Resend with a verified domain (used only when BREVO_API_KEY is empty).
# Verify a domain at resend.com/domains and set EMAIL_FROM to an address on it.
RESEND_API_KEY=
